{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/alant-web/browser",
  "functions": {
    "api/contact.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/contact",
      "headers": {
        "Cache-Control": "no-store",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/404(?:/|/index.html|.html)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
