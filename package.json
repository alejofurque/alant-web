{
  "name": "alant-web",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve --host 127.0.0.1",
    "preview": "node scripts/preview.mjs",
    "build": "ng build",
    "postbuild": "node scripts/prepare-publication.mjs && node scripts/check-function.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:server": "node --experimental-strip-types --test server/*.test.ts",
    "check:server": "tsc -p server/tsconfig.json",
    "check:function": "node scripts/check-function.mjs",
    "i18n:extract": "ng extract-i18n",
    "check:build": "node scripts/check-build.mjs",
    "format:check": "prettier --check src server api scripts/*.mjs angular.json package.json vercel.json .postcssrc.json",
    "format": "prettier --write src server api scripts/*.mjs angular.json package.json vercel.json .postcssrc.json"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "21.2.25",
    "@angular/localize": "^21.2.25",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.26",
    "gsap": "3.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
