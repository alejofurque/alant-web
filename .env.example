# Server only. Never place these values in src/, public/, Angular environments or a client bundle.
CONTACT_ENABLED=false
CONTACT_DELIVERY_VERIFIED=false
CONTACT_TO_EMAIL=alejofurque15@gmail.com
# One mailbox at your verified sending domain. Never the recipient's Gmail.
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
# Exact origin without trailing slash (preview first, production only when authorized).
CONTACT_ALLOWED_ORIGIN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters; do not reuse an API key.
CONTACT_HASH_SECRET=
# Complete, reviewed notice in Spanish: real controller, purpose, providers,
# retention, rights and a working privacy contact. This text WILL be public.
CONTACT_PRIVACY_NOTICE=
CONTACT_PRIVACY_VERSION=
CONTACT_PRIVACY_APPROVED=false
